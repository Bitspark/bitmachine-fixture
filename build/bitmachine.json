{
  "format": 1,
  "source": {
    "web-image": {
      "requires": {
        "base": {
          "package": "docker-image",
          "with": {
            "ref": "node@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402"
          }
        },
        "npm": {
          "package": "npm-lockfile",
          "with": {
            "lockfile": "package-lock.json"
          }
        }
      },
      "build": {
        "kind": "dockerfile",
        "with": {
          "dockerfile": "Dockerfile"
        }
      },
      "produces": {
        "image": {
          "kind": "docker-image"
        }
      }
    }
  },
  "deploy": {
    "web": {
      "runs": {
        "artifact": "image"
      },
      "with": {
        "user": "65534:65534",
        "cpu": 250,
        "memory": 134217728
      },
      "provides": {
        "http": {
          "port": 8080,
          "protocol": "http"
        }
      }
    }
  }
}
